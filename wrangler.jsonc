{
  "name": "sabercomun-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sabercomun-dev",
      "database_id": "487357a8-ab9e-458b-aaa5-b3b38beae91b",
      "migrations_dir": "pilot-migrations"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "sabercomun-dev",
      "database_id": "487357a8-ab9e-458b-aaa5-b3b38beae91b",
      "migrations_dir": "pilot-migrations"
    }
  ],
  "keep_vars": true
}
