{
  "name": "sabercomun",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sabercomun-db",
      "migrations_dir": "migrations"
    }
  ]
}